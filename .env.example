# ════════════════════════════════════════════════════════════════════
# aether-search 配置总览
# 原则：配啥用啥。配了哪个启用哪个，没配的静默跳过，绝不影响 MCP 运行。
# grok 端点 / 10 个后端 / Aux LLM 三个独立维度，各启各的。
# 所有项均可不填走默认；只填要启用的 key 即可。
# ════════════════════════════════════════════════════════════════════

# ── 通道 ①：Grok 主检索（官方 SDK；独立于 Agent 通道）──
# base URL 包含版本前缀，例如 https://api.x.ai/v1 或 http://localhost:8317/v1。
# xAI 官方使用 Responses 原生搜索；OpenAI 兼容及 CPA 默认使用 Chat Completions。
# 网关是否联网取决于其上游能力，模型名原样透传，不自动追加后缀。
AETHER_GROK_API_URL=https://api.x.ai/v1
AETHER_GROK_API_KEY=
AETHER_GROK_MODEL=grok-4
# auto|openai|xai|cpa；auto 仅按 api.x.ai 精确主机名识别 xAI，其余为 openai。
AETHER_GROK_PROVIDER=auto
# auto|chat_completions|responses；auto 时 xAI 走 Responses，其余走 Chat。
AETHER_GROK_API_FORMAT=auto
# 留空/auto：xAI 请求 web_search+x_search，其他不附加工具；on 显式请求 Responses 搜索。
# off/none：不携带搜索工具；无法关闭网关未公开的联网行为。Chat 不支持 on。
AETHER_GROK_SEARCH_MODE=
# 多端点 JSON，每项 url,key,model?,label?,provider?,api_format?,search_mode?；覆盖单端点。
AETHER_GROK_ENDPOINTS=
# sequential 主备切换；race 有限并发竞速，首个完整非空回答胜出（可能多耗额度）。
AETHER_GROK_FAILOVER=sequential
AETHER_GROK_MAX_CONCURRENCY=2
# 整个 Grok 调用的总时限，以及单次尝试时限（秒）；重试共享总预算。
AETHER_GROK_TIMEOUT=60
AETHER_GROK_REQUEST_TIMEOUT=45

# ── 通道 ②：Aux/Agent 检索 LLM（任意 OpenAI 兼容端点）──
# 配了才把检索证据(evidence)升级成带引用答案（工具调用）；没配则 agent 退纯证据链接。
AETHER_LLM_API_BASE=
AETHER_LLM_API_KEY=
AETHER_LLM_MODEL=
AETHER_LLM_REWRITE=true
# Aux LLM 单次调用超时（秒）
AETHER_LLM_TIMEOUT=30

# ── 检索后端（agent 通道的 10 个信源；URL 均有官方默认值，通常只填 key）──
AETHER_BRAVE_API_KEY=
#AETHER_BRAVE_API_URL=https://api.search.brave.com/res/v1
AETHER_EXA_API_KEY=
#AETHER_EXA_API_URL=https://api.exa.ai
AETHER_SERPER_API_KEY=
#AETHER_SERPER_API_URL=https://google.serper.dev
AETHER_LINKUP_API_KEY=
#AETHER_LINKUP_API_URL=https://api.linkup.so/v1
AETHER_YOUCOM_API_KEY=
#AETHER_YOUCOM_API_URL=https://api.you.com/v1
AETHER_SONAR_API_KEY=
#AETHER_SONAR_API_URL=https://api.perplexity.ai
#AETHER_SONAR_MODEL=sonar
# Tavily / Firecrawl：同时驱动 agent 扇出的 /search 与 web_fetch/web_map 的抓取。
# 若 grok-search 已在消耗其额度，这里留空；未配置的后端和抓取服务静默跳过。
AETHER_TAVILY_API_KEY=
#AETHER_TAVILY_API_URL=https://api.tavily.com
AETHER_FIRECRAWL_API_KEY=
#AETHER_FIRECRAWL_API_URL=https://api.firecrawl.dev/v2
# Parallel：质量第一梯队（platform.parallel.ai 取 key）
AETHER_PARALLEL_API_KEY=
#AETHER_PARALLEL_API_URL=https://api.parallel.ai/v1
# DeepSeek：同一 key 启用 Search + Fetch；无需 Grok，搜索词最多 128 字符。
AETHER_DEEPSEEK_API_KEY=
#AETHER_DEEPSEEK_API_URL=https://api.deepseek.com

# ── 并发 / 融合 ──
# economy（默认）= 原查询×全部后端 + 变体轮询；full = 变体×后端全交叉
AETHER_FANOUT=economy
# 含原查询的子查询数
AETHER_MAX_VARIANTS=3
# 单后端单次返回条数
AETHER_TOP_K=10
# RRF 融合常数 k
AETHER_RRF_K=60
# 并发扇出上限
AETHER_MAX_CONCURRENCY=8
# 单后端请求超时（秒）
AETHER_CONNECTOR_TIMEOUT=10

# ── 核验 ──
# 引用互证 + 死链探测总开关
AETHER_VERIFY=true
# 单 URL 探测超时（秒）
AETHER_VERIFY_TIMEOUT=2.5

# ── Agent 通道（第二答案通道：工具调用）──
# 工具调用步数上限；超步数/超时/LLM 异常用已有证据强制收尾
AETHER_AGENT_MAX_STEPS=6
# agent 通道整通道超时（含起步检索，秒）
AETHER_AGENT_TIMEOUT=90
# web_fetch 单服务超时（秒）
AETHER_FETCH_TIMEOUT=60
# Firecrawl 空内容重试次数
AETHER_SCRAPE_RETRY=3
# get_sources 会话缓存容量（LRU）
AETHER_SOURCES_CACHE_SIZE=256
# 补充层后端（逗号分隔，如 sonar,linkup）：不进 search 默认扇出，仅供 search_deep 工具调
# 用于省 sonar/linkup 等限量后端的额度——主层结果偏少时由上层 agent 决定是否调 search_deep
AETHER_FALLBACK_BACKENDS=sonar,linkup

# ── 通用 ──
# 可重试异常（网络 / 5xx / 429）的最大重试次数
AETHER_RETRY_MAX_ATTEMPTS=3
# 调试日志
AETHER_DEBUG=false
